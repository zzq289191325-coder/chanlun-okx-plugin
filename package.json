{
  "name": "chanlun-okx-plugin",
  "version": "1.1.0",
  "description": "OKX Chanlun Visualizer Plugin V1.1 multi-timeframe research edition",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --dir apps/extension typecheck",
    "test": "vitest run packages/core/test && pnpm --dir apps/extension test",
    "test:no-lookahead": "vitest run packages/core/test/noLookahead.test.ts",
    "build": "tsc -p tsconfig.build.json && pnpm --dir apps/extension build",
    "research:test": "node apps/research-service/run-python.mjs -m unittest discover -s apps/research-service/tests -v",
    "research:init": "node apps/research-service/run-python.mjs apps/research-service/research.py init",
    "research:sync": "node apps/research-service/run-python.mjs apps/research-service/research.py sync --config apps/research-service/config/example_sync_tasks.json",
    "research:audit": "node apps/research-service/run-python.mjs apps/research-service/research.py audit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.19.0"
}
