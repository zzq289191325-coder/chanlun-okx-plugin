{
  "manifest_version": 3,
  "name": "OKX Chanlun Visualizer Plugin",
  "version": "1.0.0",
  "description": "OKX 行情页面缠论结构可视化与多周期研究辅助，不执行交易。",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Toggle Chanlun Visualizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.okx.com/*", "https://*.okx.com/*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/app.js", "assets/*.js"],
      "matches": ["https://www.okx.com/*", "https://*.okx.com/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": ["storage", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://www.okx.com/*", "https://*.okx.com/*"],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Show or hide the Chanlun overlay panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.okx.com wss://ws.okx.com:8443"
  }
}
